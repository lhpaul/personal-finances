{
  "name": "finanzas",
  "version": "0.0.0",
  "private": true,
  "description": "Finanzas — personal-finance app for Chile. Turborepo + pnpm workspace root.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @finanzas/mobile dev",
    "dev:mobile:ios": "pnpm --filter @finanzas/mobile dev:ios",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "check:layout": "node scripts/check-node-linker-layout.mjs",
    "postinstall": "node scripts/check-node-linker-layout.mjs",
    "format": "prettier --write \"**/*.md\"",
    "format:code": "prettier --write \"{apps,packages}/**/*.{ts,tsx,js,jsx,json}\"",
    "mockups:mobile": "open design/mockups/mobile/index.html",
    "mockups:verify": "node scripts/design/verify-manifest.mjs",
    "mockups:verify:test": "node --test scripts/design/*.test.mjs",
    "mobile:build:dev-store": "pnpm --dir apps/mobile dlx eas-cli build --profile development",
    "mobile:build:production-store": "pnpm --dir apps/mobile dlx eas-cli build --profile production",
    "fidelity": "node scripts/mobile-ui/run-fidelity.mjs",
    "fidelity:contract": "node scripts/mobile-ui/fidelity-contract.mjs",
    "fidelity:test": "node --test scripts/mobile-ui/*.test.mjs",
    "fidelity:capture-mockup": "node scripts/mobile-ui/capture-mockup.mjs",
    "fidelity:verify-gate": "bash scripts/mobile-ui/verify-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "markdownlint-cli2": "0.22.0",
    "markdownlint-rule-relative-links": "5.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "3.8.3",
    "turbo": "^2.10.8",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0"
  }
}
